@model IEnumerable<SereGlowy.Models.RoutineRecommendation>

@{
    ViewData["Title"] = "My Routine";

    var morningRoutine = Model
        .Where(r => r.RoutineTime == "Morning")
        .OrderBy(r => r.StepOrder)
        .ToList();

    var eveningRoutine = Model
        .Where(r => r.RoutineTime == "Evening")
        .OrderBy(r => r.StepOrder)
        .ToList();
}

<section class="routine-page">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-label">
                YOUR ROUTINE
            </span>

            <h1>
                Your SereGlowy Routine
            </h1>

            <p>
                Based on your
                <strong>@ViewBag.SkinType</strong>
                skin type and
                <strong>@ViewBag.SkinGoal</strong>
                goal.
            </p>

        </div>


        @if (!Model.Any())
        {
            <div class="admin-form-card text-center">

                <span class="section-label">
                    ROUTINE COMING SOON
                </span>

                <h2>
                    No matching routine yet.
                </h2>

                <p>
                    Your skin profile is saved, but the admin
                    has not added a matching routine recommendation yet.
                </p>

                <a asp-controller="SkinProfile"
                   asp-action="Index"
                   class="btn btn-glow">

                    View My Skin Profile

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                <!-- Morning Routine -->

                <div class="col-lg-6">

                    <div class="admin-form-card h-100">

                        <div class="mb-4">

                            <span class="section-label">
                                MORNING
                            </span>

                            <h2>
                                Morning Routine
                            </h2>

                            <p>
                                Start your day with these recommended steps.
                            </p>

                        </div>


                        @if (morningRoutine.Any())
                        {
                            foreach (var step in morningRoutine)
                            {
                                <div class="routine-step mb-4">

                                    <div class="routine-step-number">
                                        @step.StepOrder
                                    </div>

                                    <div>

                                        <h3>
                                            @step.StepName
                                        </h3>

                                        <p>
                                            @step.Description
                                        </p>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p>
                                No morning routine steps available yet.
                            </p>
                        }

                    </div>

                </div>


                <!-- Evening Routine -->

                <div class="col-lg-6">

                    <div class="admin-form-card h-100">

                        <div class="mb-4">

                            <span class="section-label">
                                EVENING
                            </span>

                            <h2>
                                Evening Routine
                            </h2>

                            <p>
                                Finish your day with these recommended steps.
                            </p>

                        </div>


                        @if (eveningRoutine.Any())
                        {
                            foreach (var step in eveningRoutine)
                            {
                                <div class="routine-step mb-4">

                                    <div class="routine-step-number">
                                        @step.StepOrder
                                    </div>

                                    <div>

                                        <h3>
                                            @step.StepName
                                        </h3>

                                        <p>
                                            @step.Description
                                        </p>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p>
                                No evening routine steps available yet.
                            </p>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</section>