@model IEnumerable<SereGlowy.Models.MyProduct>

@{
    ViewData["Title"] = "My Products";
}

<section class="my-products-page">

    <div class="container">

        <!-- ===============================
             HEADER
        ================================ -->

        <div class="my-products-header text-center">

            <span class="section-label">
                MY PRODUCTS
            </span>

            <h1>
                Your skincare shelf, all in one place.
            </h1>

            <p>
                Keep track of the skincare products you use
                and manage your personal collection.
            </p>

        </div>


        <!-- ===============================
             SUCCESS MESSAGE
        ================================ -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-4">
                @TempData["SuccessMessage"]
            </div>
        }


        <!-- ===============================
             SUMMARY
        ================================ -->

        <div class="my-products-summary">

            <div class="summary-item">

                <span>
                    Saved Products
                </span>

                <strong>
                    @ViewBag.SavedCount
                </strong>

            </div>


            <div class="summary-item">

                <span>
                    Categories
                </span>

                <strong>
                    @ViewBag.CategoryCount
                </strong>

            </div>


            <div class="summary-item">

                <span>
                    Your Shelf
                </span>

                <strong>
                    ♡
                </strong>

            </div>

        </div>


        <!-- ===============================
             PRODUCTS
        ================================ -->

        <div class="row g-4 mt-2">

            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="saved-product-card">

                            <!-- IMAGE -->

                            <div class="saved-product-image">

                                <span class="saved-category">
                                    @(item.Product?.Category?.CategoryName
                                        ?? "Skincare")
                                </span>


                                @if (!string.IsNullOrWhiteSpace(
                                    item.Product?.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl"
                                         alt="@item.Product.ProductName" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        Product Image
                                    </div>
                                }

                            </div>


                            <!-- CONTENT -->

                            <div class="saved-product-content">

                                <span class="product-brand">
                                    @item.Product?.Brand
                                </span>

                                <h3>
                                    @item.Product?.ProductName
                                </h3>

                                <p>
                                    @item.Product?.Description
                                </p>


                                <!-- ACTIONS -->

                                <div class="saved-product-actions">

                                    <!-- DETAILS -->

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId">

                                        View Details

                                    </a>


                                    <!-- REMOVE FORM -->

                                    <form id="removeForm-@item.MyProductId"
                                          asp-controller="MyProducts"
                                          asp-action="Remove"
                                          asp-route-id="@item.MyProductId"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <button type="button"
                                                class="remove-product-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#removeModal-@item.MyProductId">

                                            Remove

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ===============================
                         REMOVE CONFIRMATION MODAL
                    ================================ -->

                    <div class="modal fade"
                         id="removeModal-@item.MyProductId"
                         tabindex="-1"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">

                            <div class="modal-content sereglowy-remove-modal">


                                <!-- ICON -->

                                <div class="remove-modal-icon">
                                    ♡
                                </div>


                                <!-- BODY -->

                                <div class="remove-modal-body">

                                    <span class="section-label">
                                        MY PRODUCTS
                                    </span>

                                    <h3>
                                        Remove this product?
                                    </h3>

                                    <p>
                                        Are you sure you want to remove

                                        <strong>
                                            @item.Product?.ProductName
                                        </strong>

                                        from your skincare shelf?
                                    </p>

                                </div>


                                <!-- ACTIONS -->

                                <div class="remove-modal-actions">

                                    <button type="button"
                                            class="remove-modal-cancel"
                                            data-bs-dismiss="modal">

                                        Keep It

                                    </button>


                                    <button type="submit"
                                            form="removeForm-@item.MyProductId"
                                            class="remove-modal-confirm">

                                        Yes, Remove

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }

            else
            {
                <!-- ===============================
                     EMPTY STATE
                ================================ -->

                <div class="col-12">

                    <div class="my-products-empty-note">

                        <span class="section-label">
                            YOUR SHELF IS EMPTY
                        </span>

                        <h2>
                            Add products to your shelf.
                        </h2>

                        <p>
                            Explore the skincare collection and save
                            products you want to keep organized.
                        </p>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-glow">

                            Explore Products

                        </a>

                    </div>

                </div>
            }

        </div>

    </div>

</section>