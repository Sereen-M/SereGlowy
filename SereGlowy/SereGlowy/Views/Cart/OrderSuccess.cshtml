@model SereGlowy.Models.Order

@{
    ViewData["Title"] = "Order Confirmed";
}


<section class="order-success-page">

    <div class="container">

        <div class="order-success-card">

            <div class="order-success-icon">
                ✓
            </div>

            <span class="section-label">
                ORDER CONFIRMED
            </span>

            <h1>
                Your glow is on the way.
            </h1>

            <p>
                Thank you, @Model.FullName.
                Your order has been placed successfully.
            </p>


            <div class="order-success-details">

                <div>
                    <span>Order Number</span>
                    <strong>#@Model.OrderId</strong>
                </div>

                <div>
                    <span>Total</span>
                    <strong>
                        @Model.TotalAmount.ToString("0.00") JOD
                    </strong>
                </div>

                <div>
                    <span>Status</span>
                    <strong>@Model.Status</strong>
                </div>

            </div>


            <div class="d-flex justify-content-center flex-wrap gap-2">

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="btn btn-glow">

                    View My Orders

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-glow">

                    Continue Shopping

                </a>

            </div>

        </div>

    </div>

</section>