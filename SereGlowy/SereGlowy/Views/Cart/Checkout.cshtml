@model IEnumerable<SereGlowy.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";

    var cartItems = Model?.ToList()
        ?? new List<SereGlowy.Models.CartItem>();

    decimal total = ViewBag.Total ?? 0;
}


<section class="checkout-page">

    <div class="container">

        <div class="checkout-header text-center">

            <span class="section-label">
                FINAL STEP
            </span>

            <h1>Checkout</h1>

            <p>
                Complete your delivery details and review your order.
            </p>

        </div>


        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger checkout-alert">
                @ViewBag.ErrorMessage
            </div>
        }


        <div class="row g-4">

            <!-- DELIVERY INFORMATION -->

            <div class="col-lg-7">

                <div class="checkout-card">

                    <span class="section-label">
                        DELIVERY DETAILS
                    </span>

                    <h2>Where should we send your glow?</h2>


                    <form asp-controller="Cart"
                          asp-action="Checkout"
                          method="post">

                        @Html.AntiForgeryToken()


                        <div class="checkout-form-group">

                            <label>Full Name</label>

                            <input type="text"
                                   name="fullName"
                                   class="form-control"
                                   placeholder="Enter your full name"
                                   required />

                        </div>


                        <div class="checkout-form-group">

                            <label>Phone Number</label>

                            <input type="text"
                                   name="phone"
                                   class="form-control"
                                   placeholder="07XXXXXXXX"
                                   required />

                        </div>


                        <div class="checkout-form-group">

                            <label>Delivery Address</label>

                            <textarea name="address"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter your delivery address"
                                      required></textarea>

                        </div>


                        <button type="submit"
                                class="btn btn-glow w-100 checkout-place-btn">

                            Place Order

                        </button>

                    </form>

                </div>

            </div>


            <!-- ORDER SUMMARY -->

            <div class="col-lg-5">

                <div class="checkout-summary">

                    <span class="section-label">
                        YOUR ORDER
                    </span>

                    <h2>Order Summary</h2>


                    @foreach (var item in cartItems)
                    {
                        if (item.Product != null)
                        {
                            <div class="checkout-product">

                                <div class="checkout-product-image">

                                    @if (!string.IsNullOrWhiteSpace(item.Product.ImageUrl))
                                    {
                                        <img src="@item.Product.ImageUrl"
                                             alt="@item.Product.ProductName" />
                                    }

                                </div>


                                <div class="checkout-product-info">

                                    <strong>
                                        @item.Product.ProductName
                                    </strong>

                                    <span>
                                        Qty: @item.Quantity
                                    </span>

                                </div>


                                <div class="checkout-product-price">

                                    @((item.Product.Price * item.Quantity)
                                        .ToString("0.00")) JOD

                                </div>

                            </div>
                        }
                    }


                    <div class="checkout-total">

                        <span>Total</span>

                        <strong>
                            @total.ToString("0.00") JOD
                        </strong>

                    </div>


                    <p class="checkout-payment-note">
                        Demo checkout — no real payment is processed.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>