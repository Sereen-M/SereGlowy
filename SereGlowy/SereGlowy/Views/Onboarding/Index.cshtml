@{
    ViewData["Title"] = "Build Your Skin Profile";
}

<section class="onboarding-section">
    <div class="container">

        <div class="onboarding-wrapper">

            <div class="onboarding-header text-center">

                <span class="section-label">
                    YOUR SEREGLOWY PROFILE
                </span>

                <h1>
                    Let’s get to know your skin.
                </h1>

                <p>
                    Answer a few simple questions to help SereGlowy
                    personalize your routine and product suggestions.
                </p>

            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="onboarding-progress">

                <div class="progress-top">
                    <span id="questionNumber">
                        Question 1 of 5
                    </span>

                    <span id="progressPercentage">
                        20%
                    </span>
                </div>

                <div class="progress-line">
                    <div class="progress-fill"
                         id="progressFill">
                    </div>
                </div>

            </div>

            <form asp-controller="Onboarding"
                  asp-action="CreateProfile"
                  method="post"
                  id="profileForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="skinType"
                       id="skinType" />

                <input type="hidden"
                       name="isSensitive"
                       id="isSensitive" />

                <input type="hidden"
                       name="skinGoal"
                       id="skinGoal" />

                <input type="hidden"
                       name="routineExperience"
                       id="routineExperience" />

                <input type="hidden"
                       name="makeupUsage"
                       id="makeupUsage" />


                <!-- Question 1 -->
                <div class="question-card active-question"
                     data-question="1">

                    <span class="question-small">
                        SKIN TYPE
                    </span>

                    <h2>
                        How would you describe your skin?
                    </h2>

                    <div class="answer-grid">

                        <button type="button"
                                class="answer-card"
                                data-value="Dry">
                            <strong>Dry</strong>
                            <span>
                                Often feels tight or needs extra moisture
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Oily">
                            <strong>Oily</strong>
                            <span>
                                Often feels shiny throughout the day
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Combination">
                            <strong>Combination</strong>
                            <span>
                                A mix of oily and dry areas
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Normal">
                            <strong>Normal</strong>
                            <span>
                                Generally feels balanced
                            </span>
                        </button>

                    </div>

                </div>


                <!-- Question 2 -->
                <div class="question-card"
                     data-question="2">

                    <span class="question-small">
                        SENSITIVITY
                    </span>

                    <h2>
                        Would you describe your skin as sensitive?
                    </h2>

                    <div class="answer-grid answer-grid-three">

                        <button type="button"
                                class="answer-card"
                                data-value="true">
                            <strong>Yes</strong>
                            <span>
                                My skin can react easily
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="false">
                            <strong>No</strong>
                            <span>
                                My skin usually feels comfortable
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="">
                            <strong>Not Sure</strong>
                            <span>
                                I’m still figuring it out
                            </span>
                        </button>

                    </div>

                </div>


                <!-- Question 3 -->
                <div class="question-card"
                     data-question="3">

                    <span class="question-small">
                        YOUR GOAL
                    </span>

                    <h2>
                        What would you like to focus on?
                    </h2>

                    <div class="answer-grid">

                        <button type="button"
                                class="answer-card"
                                data-value="Hydration">
                            <strong>Hydration</strong>
                            <span>
                                Keep my skin feeling moisturized
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Glow">
                            <strong>Glow</strong>
                            <span>
                                Support a brighter-looking routine
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Oil Control">
                            <strong>Oil Control</strong>
                            <span>
                                Keep my routine feeling balanced
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Smoother Look">
                            <strong>Smoother Look</strong>
                            <span>
                                Focus on a smoother-looking routine
                            </span>
                        </button>

                    </div>

                </div>


                <!-- Question 4 -->
                <div class="question-card"
                     data-question="4">

                    <span class="question-small">
                        ROUTINE EXPERIENCE
                    </span>

                    <h2>
                        What does your skincare routine look like now?
                    </h2>

                    <div class="answer-grid answer-grid-three">

                        <button type="button"
                                class="answer-card"
                                data-value="Beginner">
                            <strong>Beginner</strong>
                            <span>
                                I’m just getting started
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Simple Routine">
                            <strong>Simple Routine</strong>
                            <span>
                                I use a few basic products
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Full Routine">
                            <strong>Full Routine</strong>
                            <span>
                                I already follow several steps
                            </span>
                        </button>

                    </div>

                </div>


                <!-- Question 5 -->
                <div class="question-card"
                     data-question="5">

                    <span class="question-small">
                        MAKEUP
                    </span>

                    <h2>
                        How often do you usually wear makeup?
                    </h2>

                    <div class="answer-grid answer-grid-three">

                        <button type="button"
                                class="answer-card"
                                data-value="Often">
                            <strong>Often</strong>
                            <span>
                                Makeup is part of my regular routine
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Sometimes">
                            <strong>Sometimes</strong>
                            <span>
                                I wear it depending on the day
                            </span>
                        </button>

                        <button type="button"
                                class="answer-card"
                                data-value="Rarely">
                            <strong>Rarely</strong>
                            <span>
                                I don’t wear makeup very often
                            </span>
                        </button>

                    </div>

                </div>


                <div class="onboarding-buttons">

                    <button type="button"
                            class="btn onboarding-back"
                            id="backButton">
                        Back
                    </button>

                    <button type="button"
                            class="btn btn-glow"
                            id="nextButton">
                        Continue
                    </button>

                </div>

            </form>

        </div>

    </div>
</section>


@section Scripts {

    <script>

        let currentQuestion = 1;

        const totalQuestions = 5;

        const questions =
            document.querySelectorAll(".question-card");

        const nextButton =
            document.getElementById("nextButton");

        const backButton =
            document.getElementById("backButton");

        const questionNumber =
            document.getElementById("questionNumber");

        const progressPercentage =
            document.getElementById("progressPercentage");

        const progressFill =
            document.getElementById("progressFill");

        const answers = {
            1: null,
            2: null,
            3: null,
            4: null,
            5: null
        };


        function updateQuestion() {

            questions.forEach(question => {
                question.classList.remove("active-question");
            });

            const activeQuestion =
                document.querySelector(
                    `[data-question="${currentQuestion}"]`
                );

            activeQuestion.classList.add("active-question");


            questionNumber.textContent =
                `Question ${currentQuestion} of ${totalQuestions}`;

            const percentage =
                (currentQuestion / totalQuestions) * 100;

            progressPercentage.textContent =
                `${percentage}%`;

            progressFill.style.width =
                `${percentage}%`;


            if (currentQuestion === 1) {
                backButton.style.visibility = "hidden";
            }
            else {
                backButton.style.visibility = "visible";
            }


            if (currentQuestion === totalQuestions) {
                nextButton.textContent =
                    "Create My Profile";
            }
            else {
                nextButton.textContent =
                    "Continue";
            }
        }


        document
            .querySelectorAll(".answer-card")
            .forEach(button => {

                button.addEventListener("click", function() {

                    const questionCard =
                        this.closest(".question-card");

                    const question =
                        questionCard.dataset.question;

                    questionCard
                        .querySelectorAll(".answer-card")
                        .forEach(card => {
                            card.classList.remove("selected");
                        });

                    this.classList.add("selected");

                    answers[question] =
                        this.dataset.value;
                });

            });


        nextButton.addEventListener(
            "click",
            function() {

                if (answers[currentQuestion] === null) {

                    alert("Please select an answer.");

                    return;
                }


                if (currentQuestion < totalQuestions) {

                    currentQuestion++;

                    updateQuestion();

                }
                else {

                    document.getElementById("skinType").value =
                        answers[1];

                    document.getElementById("isSensitive").value =
                        answers[2];

                    document.getElementById("skinGoal").value =
                        answers[3];

                    document.getElementById("routineExperience").value =
                        answers[4];

                    document.getElementById("makeupUsage").value =
                        answers[5];

                    document
                        .getElementById("profileForm")
                        .submit();
                }

            });


        backButton.addEventListener(
            "click",
            function() {

                if (currentQuestion > 1) {

                    currentQuestion--;

                    updateQuestion();
                }

            });


        updateQuestion();

    </script>

}