@{
    ViewData["Title"] = "Makeup Match";
}

<section class="makeup-page">
    <div class="container">

        <div class="makeup-header text-center">

            <span class="section-label">
                MAKEUP MATCH
            </span>

            <h1>
                Find makeup that fits your preferences.
            </h1>

            <p>
                Explore makeup options based on your skin profile,
                preferred finish, and everyday routine.
            </p>

        </div>


        <div class="makeup-profile-summary">

            <span>
                Skin Type:
                <strong>Combination</strong>
            </span>

            <span>
                Makeup Usage:
                <strong>Sometimes</strong>
            </span>

            <span>
                Preferred Look:
                <strong>Natural Glow</strong>
            </span>

        </div>


        <div class="makeup-filters">

            <select>
                <option>All Categories</option>
                <option>Foundation</option>
                <option>Primer</option>
                <option>Concealer</option>
            </select>

            <select>
                <option>All Finishes</option>
                <option>Dewy</option>
                <option>Natural</option>
                <option>Matte</option>
            </select>

        </div>


        <div class="row g-4 mt-2">

            <div class="col-md-6 col-lg-4">
                <div class="makeup-product-card">

                    <div class="makeup-image">

                        <span class="makeup-badge">
                            Natural Finish
                        </span>

                        <div class="image-placeholder">
                            Makeup Image
                        </div>

                    </div>

                    <div class="makeup-content">

                        <span class="product-brand">
                            Rare Beauty
                        </span>

                        <h3>
                            Liquid Touch Foundation
                        </h3>

                        <p>
                            A lightweight foundation option for users
                            who prefer a natural-looking finish.
                        </p>

                        <div class="makeup-match-box">
                            <span>Why it may fit</span>
                            <small>
                                Combination Skin • Natural Finish
                            </small>
                        </div>

                        <a href="#">
                            View Details →
                        </a>

                    </div>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="makeup-product-card">

                    <div class="makeup-image">

                        <span class="makeup-badge">
                            Dewy Finish
                        </span>

                        <div class="image-placeholder">
                            Makeup Image
                        </div>

                    </div>

                    <div class="makeup-content">

                        <span class="product-brand">
                            e.l.f.
                        </span>

                        <h3>
                            Hydrating Primer
                        </h3>

                        <p>
                            A primer option for users who prefer
                            a softer and more hydrated makeup base.
                        </p>

                        <div class="makeup-match-box">
                            <span>Why it may fit</span>
                            <small>
                                Hydration • Dewy Finish
                            </small>
                        </div>

                        <a href="#">
                            View Details →
                        </a>

                    </div>

                </div>
            </div>


            <div class="col-md-6 col-lg-4">
                <div class="makeup-product-card">

                    <div class="makeup-image">

                        <span class="makeup-badge">
                            Soft Matte
                        </span>

                        <div class="image-placeholder">
                            Makeup Image
                        </div>

                    </div>

                    <div class="makeup-content">

                        <span class="product-brand">
                            Fenty Beauty
                        </span>

                        <h3>
                            Soft Matte Foundation
                        </h3>

                        <p>
                            A makeup option for users who prefer
                            a smoother and less shiny finish.
                        </p>

                        <div class="makeup-match-box">
                            <span>Why it may fit</span>
                            <small>
                                Combination Skin • Soft Matte
                            </small>
                        </div>

                        <a href="#">
                            View Details →
                        </a>

                    </div>

                </div>
            </div>

        </div>

    </div>
</section>