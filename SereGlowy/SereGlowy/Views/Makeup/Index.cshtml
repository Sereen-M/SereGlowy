@model IEnumerable<SereGlowy.Models.MakeupProduct>

@{
    ViewData["Title"] = "Makeup Match";
}

<section class="makeup-page">
    <div class="container">

        <div class="makeup-header text-center">

            <span class="section-label">
                MAKEUP MATCH
            </span>

            <h1>
                Find makeup that fits your preferences.
            </h1>

            <p>
                Explore makeup options based on your skin profile,
                preferred finish, and everyday routine.
            </p>

        </div>


        <div class="makeup-filters">

            <select id="categoryFilter">
                <option value="">All Categories</option>

                @foreach (var category in Model
                    .Where(m => !string.IsNullOrWhiteSpace(m.Category))
                    .Select(m => m.Category)
                    .Distinct()
                    .OrderBy(c => c))
                {
                    <option value="@category">
                        @category
                    </option>
                }
            </select>


            <select id="finishFilter">
                <option value="">All Finishes</option>

                @foreach (var finish in Model
                    .Where(m => !string.IsNullOrWhiteSpace(m.FinishType))
                    .Select(m => m.FinishType)
                    .Distinct()
                    .OrderBy(f => f))
                {
                    <option value="@finish">
                        @finish
                    </option>
                }
            </select>

        </div>


        <div class="row g-4 mt-2" id="makeupProducts">

            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4 makeup-item"
                         data-category="@product.Category"
                         data-finish="@product.FinishType">

                        <div class="makeup-product-card">

                            <div class="makeup-image">

                                @if (!string.IsNullOrWhiteSpace(product.FinishType))
                                {
                                    <span class="makeup-badge">
                                        @product.FinishType
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName"
                                         class="img-fluid" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        Makeup Image
                                    </div>
                                }

                            </div>


                            <div class="makeup-content">

                                <span class="product-brand">
                                    @product.Brand
                                </span>

                                <h3>
                                    @product.ProductName
                                </h3>

                                <p>
                                    @product.Description
                                </p>


                                <div class="makeup-match-box">

                                    <span>
                                        Why it may fit
                                    </span>

                                    <small>
                                        @product.SuitableSkinType

                                        @if (!string.IsNullOrWhiteSpace(product.SuitableSkinType)
                                            && !string.IsNullOrWhiteSpace(product.FinishType))
                                        {
                                            <text> • </text>
                                        }

                                        @product.FinishType
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">

                    <p>
                        No makeup products available yet.
                    </p>

                </div>
            }

        </div>

    </div>
</section>


<script>
    const categoryFilter = document.getElementById("categoryFilter");
    const finishFilter = document.getElementById("finishFilter");

    function filterMakeupProducts() {

        const selectedCategory =
            categoryFilter.value.toLowerCase();

        const selectedFinish =
            finishFilter.value.toLowerCase();

        const products =
            document.querySelectorAll(".makeup-item");

        products.forEach(function(product) {

            const category =
                product.dataset.category.toLowerCase();

            const finish =
                product.dataset.finish.toLowerCase();

            const categoryMatch =
                selectedCategory === "" ||
                category === selectedCategory;

            const finishMatch =
                selectedFinish === "" ||
                finish === selectedFinish;

            if (categoryMatch && finishMatch) {
                product.style.display = "";
            }
            else {
                product.style.display = "none";
            }

        });
    }

    categoryFilter.addEventListener(
        "change",
        filterMakeupProducts
    );

    finishFilter.addEventListener(
        "change",
        filterMakeupProducts
    );
</script>