@model SereGlowy.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<section class="admin-form-page">

    <div class="container">

        <div class="admin-form-header">

            <div>

                <span class="section-label">
                    ADMIN / PRODUCTS
                </span>

                <h1>
                    Edit Product
                </h1>

                <p>
                    Update product information and manage how
                    it appears across SereGlowy.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-outline-glow">

                Back to Products

            </a>

        </div>


        <div class="admin-form-card">

            <form asp-controller="Admin"
                  asp-action="EditProduct"
                  asp-route-id="@Model.ProductId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="ProductId"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="ProductName">
                                Product Name
                            </label>

                            <input asp-for="ProductName" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="Brand">
                                Brand
                            </label>

                            <input asp-for="Brand" />

                            <span asp-validation-for="Brand"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="CategoryId">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories">
                            </select>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="Price">
                                Price
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01" />

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="SuitableSkinType">
                                Suitable Skin Type
                            </label>

                            <select asp-for="SuitableSkinType">

                                <option value="Dry">
                                    Dry
                                </option>

                                <option value="Oily">
                                    Oily
                                </option>

                                <option value="Combination">
                                    Combination
                                </option>

                                <option value="Normal">
                                    Normal
                                </option>

                                <option value="All Skin Types">
                                    All Skin Types
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label for="imageInput">
                                Product Image
                            </label>

                            <input type="file"
                                   name="ImageFile"
                                   id="imageInput"
                                   class="product-image-input"
                                   accept="image/png,image/jpeg,image/jpg" />

                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                            {
                                <div class="mt-3">
                                    <p class="mb-2">Current Image:</p>

                                    <img src="@Model.ImageUrl"
                                         alt="@Model.ProductName"
                                         style="width:120px; height:120px; object-fit:contain; border-radius:12px;" />
                                </div>
                            }

                        </div>

                    </div>


                    <div class="col-12">

                        <div class="admin-form-group">

                            <label asp-for="Description">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      rows="5">
                            </textarea>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label asp-for="IsActive">
                                Status
                            </label>

                            <select asp-for="IsActive">

                                <option value="true">
                                    Active
                                </option>

                                <option value="false">
                                    Inactive
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <div class="admin-form-actions">

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-outline-glow">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-glow">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}