@{
    ViewData["Title"] = "Edit Product";
}

<section class="admin-form-page">
    <div class="container">

        <div class="admin-form-header">

            <div>
                <span class="section-label">
                    ADMIN / PRODUCTS
                </span>

                <h1>
                    Edit Product
                </h1>

                <p>
                    Update product information and manage how
                    it appears across SereGlowy.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-outline-glow">
                Back to Products
            </a>

        </div>


        <div class="admin-form-card">

            <form>

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Product Name</label>

                            <input type="text"
                                   value="Hydrating Facial Cleanser" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Brand</label>

                            <input type="text"
                                   value="CeraVe" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Category</label>

                            <select>
                                <option selected>Cleanser</option>
                                <option>Serum</option>
                                <option>Moisturizer</option>
                                <option>Sunscreen</option>
                            </select>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Price</label>

                            <input type="number"
                                   step="0.01"
                                   value="12.00" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Suitable Skin Type</label>

                            <select>
                                <option selected>Dry</option>
                                <option>Oily</option>
                                <option>Combination</option>
                                <option>Normal</option>
                                <option>All Skin Types</option>
                            </select>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Image URL</label>

                            <input type="text"
                                   value="/images/products/cleanser.jpg" />
                        </div>

                    </div>


                    <div class="col-12">

                        <div class="admin-form-group">
                            <label>Description</label>

                            <textarea rows="5">A gentle cleanser designed for a simple everyday skincare routine.</textarea>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Status</label>

                            <select>
                                <option selected>Active</option>
                                <option>Inactive</option>
                            </select>
                        </div>

                    </div>

                </div>


                <div class="admin-form-actions">

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-outline-glow">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-glow">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>
</section>