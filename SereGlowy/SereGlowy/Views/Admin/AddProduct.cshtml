@model SereGlowy.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<section class="admin-form-page">
    <div class="container">

        <div class="admin-form-header">
            <div>
                <span class="section-label">
                    ADMIN / PRODUCTS
                </span>

                <h1>Add New Product</h1>

                <p>
                    Add a skincare product and define its basic
                    information, category, and skin suitability.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-outline-glow">
                Back to Products
            </a>
        </div>


        <div class="admin-form-card">

            <form asp-controller="Admin"
                  asp-action="AddProduct"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="ProductName">
                                Product Name
                            </label>

                            <input asp-for="ProductName"
                                   placeholder="Enter product name" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="Brand">
                                Brand
                            </label>

                            <input asp-for="Brand"
                                   placeholder="Enter brand name" />

                            <span asp-validation-for="Brand"
                                  class="text-danger">
                            </span>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="CategoryId">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories">

                                <option value="">
                                    Select Category
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="Price">
                                Price
                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   placeholder="0.00" />

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="SuitableSkinType">
                                Suitable Skin Type
                            </label>

                            <select asp-for="SuitableSkinType">

                                <option value="">
                                    Select Skin Type
                                </option>

                                <option value="Dry">Dry</option>
                                <option value="Oily">Oily</option>
                                <option value="Combination">Combination</option>
                                <option value="Normal">Normal</option>
                                <option value="All Skin Types">All Skin Types</option>

                            </select>

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label for="imageInput">
                                Product Image
                            </label>

                            <input type="file"
                                   name="ImageFile"
                                   id="imageInput"
                                   class="product-image-input"
                                   accept="image/png,image/jpeg,image/jpg" />

                        </div>
                    </div>

                    <div class="col-12">
                        <div class="admin-form-group">

                            <label asp-for="Description">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      rows="5"
                                      placeholder="Write product description...">
                            </textarea>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label asp-for="IsActive">
                                Status
                            </label>

                            <select asp-for="IsActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>

                        </div>
                    </div>

                </div>


                <div class="admin-form-actions">

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-outline-glow">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-glow">
                        Add Product
                    </button>

                </div>

            </form>

        </div>

    </div>
</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const imageInput = document.getElementById("imageInput");
        const imagePreview = document.getElementById("imagePreview");

        imageInput.addEventListener("change", function() {

            const file = this.files[0];

            if (file) {

                const reader = new FileReader();

                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    imagePreview.style.display = "inline-block";
                };

                reader.readAsDataURL(file);
            }
        });
    </script>
}