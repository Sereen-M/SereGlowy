@model IEnumerable<SereGlowy.Models.MakeupProduct>

@{
    ViewData["Title"] = "Manage Makeup Products";
}

<section class="admin-manage-page">
    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>
                <span class="section-label">
                    ADMIN / MAKEUP
                </span>

                <h1>
                    Manage Makeup Products
                </h1>

                <p>
                    Manage the makeup items shown in the
                    SereGlowy Makeup Match experience.
                </p>
            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }


        <!-- Add Makeup Product -->

        <div class="admin-form-card mt-4">

            <h3 class="mb-4">
                Add Makeup Product
            </h3>

            <form asp-controller="Admin"
                  asp-action="AddMakeupProduct"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Product Name</label>

                            <input type="text"
                                   name="productName"
                                   required />

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Brand</label>

                            <input type="text"
                                   name="brand"
                                   required />

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Category</label>

                            <select name="category">

                                <option value="">
                                    Select Category
                                </option>

                                <option value="Foundation">
                                    Foundation
                                </option>

                                <option value="Primer">
                                    Primer
                                </option>

                                <option value="Concealer">
                                    Concealer
                                </option>

                                <option value="Blush">
                                    Blush
                                </option>

                                <option value="Powder">
                                    Powder
                                </option>

                            </select>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Finish Type</label>

                            <select name="finishType">

                                <option value="">
                                    Select Finish
                                </option>

                                <option value="Matte">
                                    Matte
                                </option>

                                <option value="Natural">
                                    Natural
                                </option>

                                <option value="Dewy">
                                    Dewy
                                </option>

                                <option value="Satin">
                                    Satin
                                </option>

                            </select>

                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Suitable Skin Type</label>

                            <select name="suitableSkinType">

                                <option value="">
                                    Select Skin Type
                                </option>

                                <option value="Dry">
                                    Dry
                                </option>

                                <option value="Oily">
                                    Oily
                                </option>

                                <option value="Combination">
                                    Combination
                                </option>

                                <option value="Normal">
                                    Normal
                                </option>

                                <option value="All Skin Types">
                                    All Skin Types
                                </option>

                            </select>

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="admin-form-group">

                            <label>Product Image</label>

                            <input type="file"
                                   name="ImageFile"
                                   accept="image/png,image/jpeg,image/jpg,image/webp" />

                        </div>
                    </div>


                    <div class="col-12">
                        <div class="admin-form-group">

                            <label>Description</label>

                            <textarea name="description"
                                      rows="4"></textarea>

                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="admin-form-group">

                            <label>Status</label>

                            <select name="isActive">

                                <option value="true">
                                    Active
                                </option>

                                <option value="false">
                                    Inactive
                                </option>

                            </select>

                        </div>
                    </div>


                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-glow">

                            + Add Makeup Product

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- Products Table -->

        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Finish</th>
                        <th>Suitable Skin</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @product.ProductName
                                    </strong>
                                </td>

                                <td>
                                    @product.Brand
                                </td>

                                <td>
                                    @product.Category
                                </td>

                                <td>
                                    @product.FinishType
                                </td>

                                <td>
                                    @product.SuitableSkinType
                                </td>

                                <td>

                                    @if (product.IsActive)
                                    {
                                        <span class="admin-status active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status inactive">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="admin-action-buttons">

                                        <button type="button"
                                                class="admin-edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editMakeupModal-@product.MakeupProductId">

                                            Edit

                                        </button>


                                        <form asp-controller="Admin"
                                              asp-action="DeleteMakeupProduct"
                                              asp-route-id="@product.MakeupProductId"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-delete-btn"
                                                    onclick="return confirm('Are you sure you want to delete this makeup product?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>


                            <!-- Edit Modal -->

                            <div class="modal fade"
                                 id="editMakeupModal-@product.MakeupProductId"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Edit Makeup Product
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <form asp-controller="Admin"
                                              asp-action="EditMakeupProduct"
                                              method="post"
                                              enctype="multipart/form-data">

                                            @Html.AntiForgeryToken()

                                            <div class="modal-body">

                                                <input type="hidden"
                                                       name="makeupProductId"
                                                       value="@product.MakeupProductId" />


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Product Name
                                                    </label>

                                                    <input type="text"
                                                           name="productName"
                                                           value="@product.ProductName"
                                                           required />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Brand
                                                    </label>

                                                    <input type="text"
                                                           name="brand"
                                                           value="@product.Brand"
                                                           required />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Category
                                                    </label>

                                                    <input type="text"
                                                           name="category"
                                                           value="@product.Category" />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Finish Type
                                                    </label>

                                                    <input type="text"
                                                           name="finishType"
                                                           value="@product.FinishType" />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Suitable Skin Type
                                                    </label>

                                                    <input type="text"
                                                           name="suitableSkinType"
                                                           value="@product.SuitableSkinType" />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Product Image
                                                    </label>

                                                    <input type="file"
                                                           name="ImageFile"
                                                           accept="image/png,image/jpeg,image/jpg,image/webp" />

                                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                    {
                                                        <div class="mt-3">
                                                            <p class="mb-2">Current Image:</p>

                                                            <img src="@product.ImageUrl"
                                                                 alt="@product.ProductName"
                                                                 style="width:110px;
                                                            height:110px;
                                                            object-fit:contain;
                                                            border-radius:12px;" />
                                                        </div>
                                                    }

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Description
                                                    </label>

                                                    <textarea name="description"
                                                              rows="4">@product.Description</textarea>

                                                </div>


                                                <div class="admin-form-group">

                                                    <label>Status</label>

                                                    <select name="isActive">

                                                        @if (product.IsActive)
                                                        {
                                                            <option value="true" selected>
                                                                Active
                                                            </option>

                                                            <option value="false">
                                                                Inactive
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="true">
                                                                Active
                                                            </option>

                                                            <option value="false" selected>
                                                                Inactive
                                                            </option>
                                                        }

                                                    </select>

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-outline-glow"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-glow">

                                                    Save Changes

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center py-4">

                                No makeup products found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</section>