@model IEnumerable<SereGlowy.Models.Ingredient>

@{
    ViewData["Title"] = "Manage Ingredients";
}

<section class="admin-manage-page">

    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>

                <span class="section-label">
                    ADMIN / INGREDIENTS
                </span>

                <h1>
                    Manage Ingredients
                </h1>

                <p>
                    Add and manage skincare ingredient information.
                </p>

            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }


        <!-- Add Ingredient -->

        <div class="admin-form-card mt-4">

            <h3 class="mb-4">
                Add Ingredient
            </h3>

            <form asp-controller="Admin"
                  asp-action="AddIngredient"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Ingredient Name
                            </label>

                            <input type="text"
                                   name="ingredientName"
                                   placeholder="Example: Niacinamide"
                                   required />

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Purpose
                            </label>

                            <input type="text"
                                   name="purpose"
                                   placeholder="Example: Hydration" />

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Suitable Skin Type
                            </label>

                            <select name="suitableSkinType">

                                <option value="">
                                    Select Skin Type
                                </option>

                                <option value="Dry">
                                    Dry
                                </option>

                                <option value="Oily">
                                    Oily
                                </option>

                                <option value="Combination">
                                    Combination
                                </option>

                                <option value="Normal">
                                    Normal
                                </option>

                                <option value="All Skin Types">
                                    All Skin Types
                                </option>

                            </select>

                        </div>

                    </div>


                    <div class="col-12">

                        <div class="admin-form-group">

                            <label>
                                Description
                            </label>

                            <textarea name="description"
                                      rows="4"
                                      placeholder="Write a short ingredient description..."></textarea>

                        </div>

                    </div>


                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-glow">

                            + Add Ingredient

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- Ingredients Table -->

        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>

                    <tr>
                        <th>Ingredient</th>
                        <th>Purpose</th>
                        <th>Skin Type</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var ingredient in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @ingredient.IngredientName
                                    </strong>
                                </td>


                                <td>
                                    @ingredient.Purpose
                                </td>


                                <td>
                                    @ingredient.SuitableSkinType
                                </td>


                                <td>
                                    @ingredient.Description
                                </td>


                                <td>

                                    <div class="admin-action-buttons">

                                        <button type="button"
                                                class="admin-edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editIngredientModal-@ingredient.IngredientId">

                                            Edit

                                        </button>


                                        <form asp-controller="Admin"
                                              asp-action="DeleteIngredient"
                                              asp-route-id="@ingredient.IngredientId"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-delete-btn"
                                                    onclick="return confirm('Are you sure you want to delete this ingredient?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>


                            <!-- Edit Ingredient Modal -->

                            <div class="modal fade"
                                 id="editIngredientModal-@ingredient.IngredientId"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Edit Ingredient
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <form asp-controller="Admin"
                                              asp-action="EditIngredient"
                                              method="post">

                                            @Html.AntiForgeryToken()


                                            <div class="modal-body">

                                                <input type="hidden"
                                                       name="ingredientId"
                                                       value="@ingredient.IngredientId" />


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Ingredient Name
                                                    </label>

                                                    <input type="text"
                                                           name="ingredientName"
                                                           value="@ingredient.IngredientName"
                                                           required />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Purpose
                                                    </label>

                                                    <input type="text"
                                                           name="purpose"
                                                           value="@ingredient.Purpose" />

                                                </div>


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Suitable Skin Type
                                                    </label>

                                                    <select name="suitableSkinType">

                                                        <option value="@ingredient.SuitableSkinType">
                                                            @ingredient.SuitableSkinType
                                                        </option>

                                                        <option value="Dry">
                                                            Dry
                                                        </option>

                                                        <option value="Oily">
                                                            Oily
                                                        </option>

                                                        <option value="Combination">
                                                            Combination
                                                        </option>

                                                        <option value="Normal">
                                                            Normal
                                                        </option>

                                                        <option value="All Skin Types">
                                                            All Skin Types
                                                        </option>

                                                    </select>

                                                </div>


                                                <div class="admin-form-group">

                                                    <label>
                                                        Description
                                                    </label>

                                                    <textarea name="description"
                                                              rows="4">@ingredient.Description</textarea>

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-outline-glow"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-glow">

                                                    Save Changes

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-4">

                                No ingredients found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>