@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Manage Users";
}

<section class="admin-manage-page">

    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>

                <span class="section-label">
                    ADMIN / USERS
                </span>

                <h1>
                    Manage Users
                </h1>

                <p>
                    View registered users and their assigned roles.
                </p>

            </div>

        </div>


        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Username</th>
                        <th>Role</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    @user.UserName
                                </td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="admin-status active">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status">
                                            @user.Role
                                        </span>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center py-4">

                                No users found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>