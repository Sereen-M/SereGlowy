@model IEnumerable<SereGlowy.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
}

<section class="admin-manage-page">

    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>
                <span class="section-label">
                    ADMIN / PRODUCTS
                </span>

                <h1>
                    Manage Products
                </h1>

                <p>
                    View, add, edit, and remove skincare products.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="AddProduct"
               class="btn btn-glow">
                + Add Product
            </a>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }


        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Brand</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Skin Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @product.ProductName
                                    </strong>
                                </td>

                                <td>
                                    @product.Brand
                                </td>

                                <td>
                                    @(product.Category?.CategoryName ?? "No Category")
                                </td>

                                <td>
                                    @product.Price.ToString("0.00")
                                </td>

                                <td>
                                    @product.SuitableSkinType
                                </td>

                                <td>

                                    @if (product.IsActive)
                                    {
                                        <span class="admin-status active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="admin-action-buttons">

                                        <a asp-controller="Admin"
                                           asp-action="EditProduct"
                                           asp-route-id="@product.ProductId"
                                           class="admin-edit-btn">

                                            Edit

                                        </a>


                                        <form asp-controller="Admin"
                                              asp-action="DeleteProduct"
                                              asp-route-id="@product.ProductId"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-delete-btn"
                                                    onclick="return confirm('Are you sure you want to delete this product?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center py-4">

                                No products found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>