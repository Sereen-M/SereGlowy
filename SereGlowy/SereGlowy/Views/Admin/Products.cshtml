@{
    ViewData["Title"] = "Add Product";
}

<section class="admin-form-page">
    <div class="container">

        <div class="admin-form-header">

            <div>
                <span class="section-label">
                    ADMIN / PRODUCTS
                </span>

                <h1>
                    Add New Product
                </h1>

                <p>
                    Add a skincare product and define its basic
                    information, category, and skin suitability.
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-outline-glow">
                Back to Products
            </a>

        </div>


        <div class="admin-form-card">

            <form>

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Product Name</label>

                            <input type="text"
                                   placeholder="Enter product name" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Brand</label>

                            <input type="text"
                                   placeholder="Enter brand name" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Category</label>

                            <select>
                                <option>Select Category</option>
                                <option>Cleanser</option>
                                <option>Serum</option>
                                <option>Moisturizer</option>
                                <option>Sunscreen</option>
                            </select>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Price</label>

                            <input type="number"
                                   step="0.01"
                                   placeholder="0.00" />
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Suitable Skin Type</label>

                            <select>
                                <option>Select Skin Type</option>
                                <option>Dry</option>
                                <option>Oily</option>
                                <option>Combination</option>
                                <option>Normal</option>
                                <option>All Skin Types</option>
                            </select>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Image URL</label>

                            <input type="text"
                                   placeholder="Enter image URL" />
                        </div>

                    </div>


                    <div class="col-12">

                        <div class="admin-form-group">
                            <label>Description</label>

                            <textarea rows="5"
                                      placeholder="Write product description...">
                            </textarea>
                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">
                            <label>Status</label>

                            <select>
                                <option>Active</option>
                                <option>Inactive</option>
                            </select>
                        </div>

                    </div>

                </div>


                <div class="admin-form-actions">

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-outline-glow">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-glow">
                        Add Product
                    </button>

                </div>

            </form>

        </div>

    </div>
</section>