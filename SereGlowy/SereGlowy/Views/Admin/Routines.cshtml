@model IEnumerable<SereGlowy.Models.RoutineRecommendation>

@{
    ViewData["Title"] = "Manage Routines";
}

<section class="admin-manage-page">

    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>

                <span class="section-label">
                    ADMIN / ROUTINES
                </span>

                <h1>
                    Manage Routine Recommendations
                </h1>

                <p>
                    Create skincare routine steps based on skin type,
                    skin goal, and routine time.
                </p>

            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }


        <!-- Add Routine -->

        <div class="admin-form-card mt-4">

            <h3 class="mb-4">
                Add Routine Step
            </h3>

            <form asp-controller="Admin"
                  asp-action="AddRoutine"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">


                    <!-- Skin Type -->
                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Skin Type
                            </label>

                            <select name="skinType" required>

                                <option value="">
                                    Select Skin Type
                                </option>

                                <option value="Dry">
                                    Dry
                                </option>

                                <option value="Oily">
                                    Oily
                                </option>

                                <option value="Combination">
                                    Combination
                                </option>

                                <option value="Normal">
                                    Normal
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Skin Goal -->
                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Skin Goal
                            </label>

                            <select name="skinGoal" required>

                                <option value="">
                                    Select Skin Goal
                                </option>

                                <option value="Hydration">
                                    Hydration
                                </option>

                                <option value="Glow">
                                    Glow
                                </option>

                                <option value="Oil Control">
                                    Oil Control
                                </option>

                                <option value="Smoother Look">
                                    Smoother Look
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Routine Time -->
                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Routine Time
                            </label>

                            <select name="routineTime" required>

                                <option value="">
                                    Select Routine Time
                                </option>

                                <option value="Morning">
                                    Morning
                                </option>

                                <option value="Evening">
                                    Evening
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Step Order -->
                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Step Order
                            </label>

                            <input type="number"
                                   name="stepOrder"
                                   min="1"
                                   required />

                        </div>

                    </div>


                    <!-- Step Name -->
                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Step Name
                            </label>

                            <input type="text"
                                   name="stepName"
                                   placeholder="Example: Cleanser"
                                   required />

                        </div>

                    </div>


                    <!-- Description -->
                    <div class="col-12">

                        <div class="admin-form-group">

                            <label>
                                Description
                            </label>

                            <textarea name="description"
                                      rows="4"
                                      placeholder="Describe this routine step..."></textarea>

                        </div>

                    </div>


                    <div class="col-12">

                        <button type="submit"
                                class="btn btn-glow">

                            + Add Routine Step

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- Routine Table -->

        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>

                    <tr>
                        <th>Skin Type</th>
                        <th>Goal</th>
                        <th>Time</th>
                        <th>Order</th>
                        <th>Step</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var routine in Model)
                        {
                            <tr>

                                <td>
                                    @routine.SkinType
                                </td>


                                <td>
                                    @routine.SkinGoal
                                </td>


                                <td>
                                    @routine.RoutineTime
                                </td>


                                <td>
                                    @routine.StepOrder
                                </td>


                                <td>

                                    <strong>
                                        @routine.StepName
                                    </strong>

                                </td>


                                <td>
                                    @routine.Description
                                </td>


                                <td>

                                    <div class="admin-action-buttons">

                                        <!-- Edit -->

                                        <button type="button"
                                                class="admin-edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editRoutineModal-@routine.RoutineRecommendationId">

                                            Edit

                                        </button>


                                        <!-- Delete -->

                                        <form asp-controller="Admin"
                                              asp-action="DeleteRoutine"
                                              asp-route-id="@routine.RoutineRecommendationId"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-delete-btn"
                                                    onclick="return confirm('Are you sure you want to delete this routine step?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>


                            <!-- Edit Modal -->

                            <div class="modal fade"
                                 id="editRoutineModal-@routine.RoutineRecommendationId"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Edit Routine Step
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <form asp-controller="Admin"
                                              asp-action="EditRoutine"
                                              method="post">

                                            @Html.AntiForgeryToken()


                                            <div class="modal-body">

                                                <input type="hidden"
                                                       name="routineRecommendationId"
                                                       value="@routine.RoutineRecommendationId" />


                                                <!-- Skin Type -->

                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Skin Type
                                                    </label>

                                                    <input type="text"
                                                           name="skinType"
                                                           value="@routine.SkinType"
                                                           required />

                                                </div>


                                                <!-- Goal -->

                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Skin Goal
                                                    </label>

                                                    <input type="text"
                                                           name="skinGoal"
                                                           value="@routine.SkinGoal"
                                                           required />

                                                </div>


                                                <!-- Time -->

                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Routine Time
                                                    </label>

                                                    <select name="routineTime">

                                                        @if (routine.RoutineTime == "Morning")
                                                        {
                                                            <option value="Morning" selected>
                                                                Morning
                                                            </option>

                                                            <option value="Evening">
                                                                Evening
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="Morning">
                                                                Morning
                                                            </option>

                                                            <option value="Evening" selected>
                                                                Evening
                                                            </option>
                                                        }

                                                    </select>

                                                </div>


                                                <!-- Step Order -->

                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Step Order
                                                    </label>

                                                    <input type="number"
                                                           name="stepOrder"
                                                           value="@routine.StepOrder"
                                                           min="1"
                                                           required />

                                                </div>


                                                <!-- Step Name -->

                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Step Name
                                                    </label>

                                                    <input type="text"
                                                           name="stepName"
                                                           value="@routine.StepName"
                                                           required />

                                                </div>


                                                <!-- Description -->

                                                <div class="admin-form-group">

                                                    <label>
                                                        Description
                                                    </label>

                                                    <textarea name="description"
                                                              rows="4">@routine.Description</textarea>

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-outline-glow"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-glow">

                                                    Save Changes

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-4">

                                No routine recommendations found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>