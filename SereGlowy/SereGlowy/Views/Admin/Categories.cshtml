@{
    ViewData["Title"] = "Manage Categories";
}

<section class="admin-manage-page">
    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>
                <span class="section-label">
                    ADMIN / CATEGORIES
                </span>

                <h1>
                    Manage Categories
                </h1>

                <p>
                    Organize skincare products into clear and simple categories.
                </p>
            </div>

            <button type="button"
                    class="btn btn-glow">
                + Add Category
            </button>

        </div>


        <div class="admin-toolbar">

            <div class="admin-search-box">
                <input type="text"
                       placeholder="Search categories..." />
            </div>

        </div>


        <div class="admin-table-wrapper">

            <table class="admin-table manage-table">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <strong>Cleanser</strong>
                        </td>

                        <td>
                            Products used to clean the skin.
                        </td>

                        <td>
                            8 Products
                        </td>

                        <td>
                            <div class="admin-action-buttons">

                                <button type="button"
                                        class="admin-edit-btn">
                                    Edit
                                </button>

                                <button type="button"
                                        class="admin-delete-btn">
                                    Delete
                                </button>

                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <strong>Serum</strong>
                        </td>

                        <td>
                            Lightweight skincare treatments.
                        </td>

                        <td>
                            12 Products
                        </td>

                        <td>
                            <div class="admin-action-buttons">

                                <button type="button"
                                        class="admin-edit-btn">
                                    Edit
                                </button>

                                <button type="button"
                                        class="admin-delete-btn">
                                    Delete
                                </button>

                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <strong>Moisturizer</strong>
                        </td>

                        <td>
                            Products focused on daily moisture.
                        </td>

                        <td>
                            10 Products
                        </td>

                        <td>
                            <div class="admin-action-buttons">

                                <button type="button"
                                        class="admin-edit-btn">
                                    Edit
                                </button>

                                <button type="button"
                                        class="admin-delete-btn">
                                    Delete
                                </button>

                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td>
                            <strong>Sunscreen</strong>
                        </td>

                        <td>
                            Daily sun protection products.
                        </td>

                        <td>
                            6 Products
                        </td>

                        <td>
                            <div class="admin-action-buttons">

                                <button type="button"
                                        class="admin-edit-btn">
                                    Edit
                                </button>

                                <button type="button"
                                        class="admin-delete-btn">
                                    Delete
                                </button>

                            </div>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>
</section>