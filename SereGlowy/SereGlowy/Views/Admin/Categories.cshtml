@model IEnumerable<SereGlowy.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<section class="admin-manage-page">
    <div class="container-fluid">

        <div class="admin-manage-header">

            <div>
                <span class="section-label">
                    ADMIN / CATEGORIES
                </span>

                <h1>
                    Manage Categories
                </h1>

                <p>
                    Organize skincare products into clear and simple categories.
                </p>
            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["ErrorMessage"]
            </div>
        }


        <!-- Add Category -->

        <div class="admin-form-card mt-4">

            <h3 class="mb-3">
                Add Category
            </h3>

            <form asp-controller="Admin"
                  asp-action="AddCategory"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="admin-form-group">

                            <label>
                                Category Name
                            </label>

                            <input type="text"
                                   name="categoryName"
                                   placeholder="Example: Eye Cream"
                                   required />

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="admin-form-group">

                            <label>
                                Description
                            </label>

                            <input type="text"
                                   name="description"
                                   placeholder="Write a short description..." />

                        </div>

                    </div>


                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-glow w-100">

                            + Add Category

                        </button>

                    </div>

                </div>

            </form>

        </div>


        <!-- Categories Table -->

        <div class="admin-table-wrapper mt-4">

            <table class="admin-table manage-table">

                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var category in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @category.CategoryName
                                    </strong>
                                </td>


                                <td>
                                    @category.Description
                                </td>


                                <td>
                                    @(category.Products?.Count ?? 0) Products
                                </td>


                                <td>

                                    <div class="admin-action-buttons">

                                        <button type="button"
                                                class="admin-edit-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editCategoryModal-@category.CategoryId">

                                            Edit

                                        </button>


                                        <form asp-controller="Admin"
                                              asp-action="DeleteCategory"
                                              asp-route-id="@category.CategoryId"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-delete-btn"
                                                    onclick="return confirm('Are you sure you want to delete this category?');">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>


                            <!-- Edit Modal -->

                            <div class="modal fade"
                                 id="editCategoryModal-@category.CategoryId"
                                 tabindex="-1">

                                <div class="modal-dialog modal-dialog-centered">

                                    <div class="modal-content">

                                        <div class="modal-header">

                                            <h5 class="modal-title">
                                                Edit Category
                                            </h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>

                                        </div>


                                        <form asp-controller="Admin"
                                              asp-action="EditCategory"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <div class="modal-body">

                                                <input type="hidden"
                                                       name="categoryId"
                                                       value="@category.CategoryId" />


                                                <div class="admin-form-group mb-3">

                                                    <label>
                                                        Category Name
                                                    </label>

                                                    <input type="text"
                                                           name="categoryName"
                                                           value="@category.CategoryName"
                                                           required />

                                                </div>


                                                <div class="admin-form-group">

                                                    <label>
                                                        Description
                                                    </label>

                                                    <textarea name="description"
                                                              rows="4">@category.Description</textarea>

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-outline-glow"
                                                        data-bs-dismiss="modal">

                                                    Cancel

                                                </button>

                                                <button type="submit"
                                                        class="btn btn-glow">

                                                    Save Changes

                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center py-4">

                                No categories found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</section>