@model IEnumerable<SereGlowy.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<section class="products-hero">
    <div class="container text-center">

        <span class="section-label">
            DISCOVER YOUR MATCH
        </span>

        <h1>
            Skincare made easier to explore.
        </h1>

        <p>
            Browse skincare products, explore categories,
            and discover options that match your skin preferences.
        </p>

    </div>
</section>


<section class="products-section">
    <div class="container">

        <div class="products-toolbar">

            <div class="product-search">
                <input type="text"
                       placeholder="Search products..." />
            </div>

            <div class="product-filter">
                <select>
                    <option>All Categories</option>
                    <option>Cleanser</option>
                    <option>Serum</option>
                    <option>Moisturizer</option>
                    <option>Sunscreen</option>
                </select>
            </div>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-4">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info mt-4">
                @TempData["InfoMessage"]
            </div>
        }


        <div class="row g-4 mt-2">

            @if (Model != null && Model.Any())
            {
                foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="product-card">

                            <div class="product-image">

                                <span class="product-tag">
                                    @(product.Category?.CategoryName ?? "Skincare")
                                </span>

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName"
                                         class="img-fluid" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        Product Image
                                    </div>
                                }

                            </div>


                            <div class="product-content">

                                <span class="product-brand">
                                    @product.Brand
                                </span>

                                <h3>
                                    @product.ProductName
                                </h3>

                                <p>
                                    @product.Description
                                </p>


                                <div class="product-bottom">

                                    <span class="product-price">
                                        @product.Price.ToString("0.00") JOD
                                    </span>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId"
                                       class="product-link">

                                        View Details →

                                    </a>

                                </div>


                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Cart"
                                          asp-action="Add"
                                          method="post"
                                          class="mt-3">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.ProductId" />

                                        <button type="submit"
                                                class="btn btn-glow w-100">

                                            🛒 Add to Cart

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">

                    <h3>
                        No products available yet.
                    </h3>

                    <p>
                        Products added by the admin will appear here.
                    </p>

                </div>
            }

        </div>

    </div>
</section>