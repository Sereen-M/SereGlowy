@model SereGlowy.Models.Product

@{
    ViewData["Title"] = Model.ProductName;
}

<section class="product-details-section">
    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-6">
                <div class="details-image-box">

                    <span class="details-tag">
                        @(Model.Category?.CategoryName ?? "Skincare")
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.ProductName"
                             class="details-product-image" />
                    }
                    else
                    {
                        <div class="details-image-placeholder">
                            Product Image
                        </div>
                    }

                </div>
            </div>


            <div class="col-lg-6">

                <div class="details-content">

                    <span class="product-brand">
                        @Model.Brand
                    </span>

                    <h1>
                        @Model.ProductName
                    </h1>

                    <p class="details-description">
                        @Model.Description
                    </p>


                    <div class="details-info">

                        <div class="details-info-item">
                            <span>Suitable Skin Type</span>
                            <strong>
                                @Model.SuitableSkinType
                            </strong>
                        </div>

                        <div class="details-info-item">
                            <span>Category</span>
                            <strong>
                                @(Model.Category?.CategoryName ?? "Skincare")
                            </strong>
                        </div>

                        <div class="details-info-item">
                            <span>Brand</span>
                            <strong>
                                @Model.Brand
                            </strong>
                        </div>

                    </div>


                    <div class="details-price">
                        @Model.Price.ToString("0.00") JOD
                    </div>


                    <div class="details-buttons">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- ADD TO CART -->
                            <form asp-controller="Cart"
                                  asp-action="Add"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@Model.ProductId" />

                                <button type="submit"
                                        class="btn btn-glow">

                                    🛒 Add to Cart

                                </button>

                            </form>


                            <!-- ADD TO MY PRODUCTS -->
                            <form asp-controller="MyProducts"
                                  asp-action="Add"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@Model.ProductId" />

                                <button type="submit"
                                        class="btn btn-outline-glow">

                                    ♡ Add to My Products

                                </button>

                            </form>
                        }


                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-glow">

                            Back to Products

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>