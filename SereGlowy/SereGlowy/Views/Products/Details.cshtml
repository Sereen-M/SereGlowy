@{
    ViewData["Title"] = "Product Details";
}

<section class="product-details-section">
    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-6">
                <div class="details-image-box">

                    <span class="details-tag">
                        Cleanser
                    </span>

                    <div class="details-image-placeholder">
                        Product Image
                    </div>

                </div>
            </div>

            <div class="col-lg-6">

                <div class="details-content">

                    <span class="product-brand">
                        CeraVe
                    </span>

                    <h1>
                        Hydrating Facial Cleanser
                    </h1>

                    <p class="details-description">
                        A gentle daily cleanser designed to fit into
                        a simple skincare routine while helping users
                        keep their skincare experience organized.
                    </p>

                    <div class="details-info">

                        <div class="details-info-item">
                            <span>Suitable Skin Type</span>
                            <strong>Dry / Normal</strong>
                        </div>

                        <div class="details-info-item">
                            <span>Category</span>
                            <strong>Cleanser</strong>
                        </div>

                        <div class="details-info-item">
                            <span>Brand</span>
                            <strong>CeraVe</strong>
                        </div>

                    </div>

                    <div class="details-price">
                        12.00 JOD
                    </div>

                    <div class="details-buttons">

                        <a href="#"
                           class="btn btn-glow">
                            Add to My Products
                        </a>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-glow">
                            Back to Products
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<section class="details-extra-section">
    <div class="container">

        <div class="row g-4">

            <div class="col-md-6">

                <div class="details-extra-card">

                    <span class="section-label">
                        WHY IT MAY FIT
                    </span>

                    <h3>
                        Simple everyday skincare.
                    </h3>

                    <p>
                        This product can be included as the cleansing
                        step in a morning or evening skincare routine.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="details-extra-card">

                    <span class="section-label">
                        RELATED INGREDIENTS
                    </span>

                    <h3>
                        Learn what’s inside.
                    </h3>

                    <p>
                        Explore the skincare ingredients related to
                        this product in the SereGlowy Ingredients Guide.
                    </p>

                    <a href="#">
                        Explore Ingredients →
                    </a>

                </div>

            </div>

        </div>

    </div>
</section>