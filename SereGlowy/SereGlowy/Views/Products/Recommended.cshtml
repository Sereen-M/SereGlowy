@model SereGlowy.Models.RecommendedProductsViewModel

@{
    ViewData["Title"] = "Recommended Products";
}

<section class="recommended-page">

    <div class="container">

        <div class="recommended-header text-center">

            <span class="section-label">
                YOUR SEREGLOWY MATCHES
            </span>

            <h1>
                Products picked for your skin.
            </h1>

            <p>
                Based on your skin type, here are skincare products
                that may fit your SereGlowy profile.
            </p>

        </div>


        <div class="recommended-profile">

            <span>
                Skin Type:
                <strong>@Model.SkinProfile.SkinType</strong>
            </span>

            <span>
                Goal:
                <strong>@Model.SkinProfile.SkinGoal</strong>
            </span>

            <span>
                Routine:
                <strong>@Model.SkinProfile.RoutineExperience</strong>
            </span>

        </div>


        @if (Model.Products.Any())
        {
            <div class="row g-4 mt-3">

                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-lg-4">

                        <div class="recommended-card">

                            <div class="recommended-image">

                                <span class="match-badge">
                                    ✦ Recommended
                                </span>

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="image-placeholder">
                                        Product Image
                                    </div>
                                }

                            </div>


                            <div class="recommended-content">

                                <span class="product-brand">
                                    @product.Brand
                                </span>

                                <h3>
                                    @product.ProductName
                                </h3>

                                <p>
                                    @product.Description
                                </p>


                                <div class="why-match">

                                    <span>
                                        Why it matches
                                    </span>

                                    <small>
                                        @Model.SkinProfile.SkinType Skin
                                        •
                                        @(product.Category?.CategoryName ?? "Skincare")
                                    </small>

                                </div>


                                <div class="recommended-bottom">

                                    <span class="product-price">
                                        @product.Price.ToString("0.00") JOD
                                    </span>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.ProductId">

                                        View Details →

                                    </a>

                                </div>


                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post"
                                      class="mt-3">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.ProductId" />

                                    <button type="submit"
                                            class="btn btn-glow w-100">

                                        🛒 Add to Cart

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="recommended-empty">

                <h2>No matches yet.</h2>

                <p>
                    We don't have products for this skin type yet.
                    Explore the full skincare collection instead.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-glow">

                    Browse All Products

                </a>

            </div>
        }


        <div class="recommended-more">

            <div>
                <span class="section-label">
                    WANT MORE OPTIONS?
                </span>

                <h2>
                    Explore the full skincare collection.
                </h2>

                <p>
                    Discover more skincare products available on SereGlowy.
                </p>
            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-glow">

                Browse All Products

            </a>

        </div>

    </div>

</section>