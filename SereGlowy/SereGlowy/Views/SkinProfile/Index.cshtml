@model SereGlowy.Models.SkinProfile

@{
    ViewData["Title"] = "My Skin Profile";
}

<section class="skin-profile-page">

    <div class="container">

        <div class="text-center mb-5">

            <span class="section-label">
                MY SKIN PROFILE
            </span>

            <h1>
                Your SereGlowy Profile
            </h1>

            <p>
                Review your skincare preferences and update them anytime.
            </p>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4">
                @TempData["SuccessMessage"]
            </div>
        }


        <div class="admin-form-card">

            <div class="row g-4">

                <div class="col-md-6">
                    <span class="section-label">
                        SKIN TYPE
                    </span>

                    <h3>
                        @Model.SkinType
                    </h3>
                </div>


                <div class="col-md-6">
                    <span class="section-label">
                        SENSITIVE SKIN
                    </span>

                    <h3>
                        @(Model.IsSensitive == true ? "Yes" :
                          Model.IsSensitive == false ? "No" : "Not specified")
                    </h3>
                </div>


                <div class="col-md-6">
                    <span class="section-label">
                        SKIN GOAL
                    </span>

                    <h3>
                        @Model.SkinGoal
                    </h3>
                </div>


                <div class="col-md-6">
                    <span class="section-label">
                        ROUTINE EXPERIENCE
                    </span>

                    <h3>
                        @Model.RoutineExperience
                    </h3>
                </div>


                <div class="col-md-6">
                    <span class="section-label">
                        MAKEUP USAGE
                    </span>

                    <h3>
                        @Model.MakeupUsage
                    </h3>
                </div>

            </div>


            <div class="admin-form-actions mt-4">

                <a asp-controller="SkinProfile"
                   asp-action="Edit"
                   class="btn btn-glow">

                    Edit Profile

                </a>

                <a asp-controller="Products"
                   asp-action="Recommended"
                   class="btn btn-outline-glow">

                    View Recommendations

                </a>

            </div>

        </div>

    </div>

</section>