@model SereGlowy.Models.Ingredient

@{
    ViewData["Title"] = Model.IngredientName;
}

<section class="ingredients-hero">
    <div class="container text-center">

        <span class="section-label">
            INGREDIENT DETAILS
        </span>

        <h1>
            @Model.IngredientName
        </h1>

        <p>
            Learn more about this skincare ingredient and how it may fit into your routine.
        </p>

    </div>
</section>


<section class="ingredient-details-section">
    <div class="container">

        <div class="ingredient-details-card">

            <div class="ingredient-details-item">
                <span>Purpose</span>
                <h4>
                    @(string.IsNullOrWhiteSpace(Model.Purpose)
                        ? "Not specified"
                        : Model.Purpose)
                </h4>
            </div>

            <div class="ingredient-details-item">
                <span>Suitable Skin Type</span>
                <h4>
                    @(string.IsNullOrWhiteSpace(Model.SuitableSkinType)
                        ? "Not specified"
                        : Model.SuitableSkinType)
                </h4>
            </div>

            <div class="ingredient-details-description">
                <span>Description</span>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description available."
                        : Model.Description)
                </p>
            </div>

            <a asp-controller="Ingredients"
               asp-action="Index"
               class="btn btn-outline-glow">

                ← Back to Ingredients

            </a>

        </div>

    </div>
</section>